# SuperCoder MCP Setup - Port Configuration Template
# Copy this file to .env and modify the ports as needed

# Memory Bank Server Port
# This is the port the Memory Bank server will be accessible on
# Default: 8081 (changed from 8080 to avoid conflicts)
MEMORY_BANK_PORT=8081

# Archon HTTP MCP Port (if using Archon integration)
# This port is used when integrating with Archon via HTTP MCP connection
# Default: 8051
ARCHON_MCP_PORT=8051

# Backup ports (if primary ports are unavailable)
# These ports will be tried if the primary ports are already in use
MEMORY_BANK_BACKUP_PORT=8082
ARCHON_MCP_BACKUP_PORT=8052

# Additional Configuration Options:

# API Keys (can also be configured here instead of interactive prompts)
# Uncomment and set these to skip interactive API key setup
# Note: Context7 does not require an API key
# TAVILY_API_KEY=your_tavily_api_key_here

# Memory Bank Configuration
# MEMORY_BANK_STORAGE_DIR=/data
# MEMORY_NAMESPACE=default-project

# Filesystem MCP Configuration  
# FS_ALLOWED_PATHS=/workspace,/home/user/projects
# FS_READONLY=false

# Git MCP Configuration
# GIT_REPO_PATH=/workspace/repo
# GIT_DEFAULT_BRANCH=main
# GIT_ALLOW_WRITE=false

# Sequential Thinking Configuration
# SEQ_MAX_STEPS=12

# Fetch Configuration
# FETCH_TIMEOUT_MS=20000
# FETCH_MAX_LENGTH=500000

# Tavily Configuration
# TAVILY_MAX_RESULTS=5

# Obsidian Configuration
# OBSIDIAN_VAULT_PATH=/home/user/Obsidian/MyVault
# OBSIDIAN_READONLY=true

# Knowledge Graph Memory Configuration
# KG_DB_PATH=/workspace/.kgmcp/db.sqlite
# KG_MAX_NODES=50000